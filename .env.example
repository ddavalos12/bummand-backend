# =====================================================================
# BUMAND - Variables de Entorno del Backend (NestJS 11+ & TypeORM)
# =====================================================================

# Configuración de la base de datos PostgreSQL (Local o Supabase)
DB_TYPE=postgres
# DATABASE_URL tiene prioridad si se define (ej. Supabase Pooler o Direct Connection)
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_CONTRASENA=tu_contrasena_aqui
DB_DATABASE=bumand-db
SSL_ENABLED=false
# true para sincronizar automáticamente el esquema en desarrollo local, false en producción
SINCRONIZAR_DB=true

# Configuración Supabase (Opcional en local, requerido en nube)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_PUBLISHABLE_KEY=tu_publishable_key_aqui
SUPABASE_SECRET_KEY=tu_secret_key_aqui
SUPABASE_JWKS_URL=https://tu-proyecto.supabase.co/auth/v1/.well-known/jwks.json

# Configuración del servidor HTTP
PORT=3002

# Configuración de JWT
JWT_SECRET=tu_secreto_super_seguro_para_jwt_aqui
JWT_EXPIRATION_TIME=30d

# Motor PDF Puppeteer: "local" (Desktop) o "cloud" (Vercel Serverless con @sparticuz/chromium)
PUPPETEER_MODE=local
PUPPETEER_SKIP_DOWNLOAD=false
PUPPETEER_EXECUTABLE_PATH=
PUPPETEER_BLOQUEAR_RECURSOS_EXTERNOS=false
# Opcional: dejar vacío para usar el binario pre-empaquetado de @sparticuz/chromium sin descargas externas
PUPPETEER_CHROMIUM_PACK_URL=
SWAGGER_ENABLED=true

# Almacenamiento de Archivos: "local" (./uploads) o "r2" (Cloudflare R2 S3)
STORAGE_MODE=local
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_BUCKET_NAME=bumand-archivos
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=

# Control de semilla automática al arranque (true en Serverless)
OMITIR_SEMILLA_INICIO=false

# Administrador Primario del Sistema BUMAND
ADMIN_PRIMARIO_NOMBRE="Administrador Primario BUMAND"
ADMIN_PRIMARIO_CORREO=admin@bumand.bo
ADMIN_PRIMARIO_CONTRASENA=CambiarEnProduccion!
