# =====================================================================
# BUMAND - Variables de Entorno del Backend (NestJS 11+ & TypeORM)
# =====================================================================

# Configuración de la base de datos PostgreSQL
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_CONTRASENA=tu_contraseña_aqui
DB_DATABASE=bumand-db
SSL_ENABLED=false
# true para sincronizar automáticamente el esquema en desarrollo local, false en producción
SINCRONIZAR_DB=true

# Configuración del servidor HTTP
PORT=3002

# Configuración de JWT
JWT_SECRET=tu_secreto_super_seguro_para_jwt_aqui
JWT_EXPIRATION_TIME=30d

# Administrador Primario del Sistema BUMAND
# Valores por defecto para inicialización de base de datos limpia o resiembra total
ADMIN_PRIMARIO_NOMBRE="Administrador Primario BUMAND"
ADMIN_PRIMARIO_CORREO=admin@bumand.bo
ADMIN_PRIMARIO_CONTRASENA=Admin2026!
